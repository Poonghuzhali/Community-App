# ------------------------------------------------------------------
# Community Connect API - environment
# Copy this file to `.env` and fill in your values.
# ------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# SQLite database file. Created automatically on migrate.
SQLITE_PATH=./data/community.db

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Dev convenience: everyone logs in with this OTP (ignored in production)
FIXED_DEV_OTP=123456

# Public base URL used in image links returned by the API
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGINS=*

# Firebase Cloud Messaging (optional - notification feed works without it)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
