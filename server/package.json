{
  "name": "community-connect-server",
  "version": "1.0.0",
  "private": true,
  "description": "Community Connect REST API - Node.js/Express + SQLite",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:prod": "npm run migrate && npm run seed && npm start",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "node --test --test-reporter spec"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^12.5.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0"
  }
}
